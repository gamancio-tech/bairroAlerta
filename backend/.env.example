# ==========================================
# Variáveis de ambiente do back-end
# Copie este arquivo para .env e preencha com os seus valores.
# NUNCA coloque credenciais reais neste arquivo: ele vai para o GitHub.
# ==========================================

# Porta do servidor (no Render/Railway a variável PORT é injetada automaticamente)
PORT=3333

# Chave secreta para assinar os tokens JWT (obrigatória, mínimo de 32 caracteres).
# Para gerar uma: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria-com-32-ou-mais-caracteres"

# String de conexão do PostgreSQL (obrigatória). Exemplos de provedores:
#   Neon:   postgresql://USUARIO:SENHA@HOST.neon.tech/NOME_DO_BANCO?sslmode=require
#   Render: postgresql://USUARIO:SENHA@HOST/NOME_DO_BANCO
#   Local:  postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# Origens do front-end autorizadas pelo CORS, separadas por vírgula (opcional).
# Se não for definida, usa o front-end publicado na Vercel e os endereços locais de desenvolvimento.
# CORS_ORIGIN="https://bairroalerta-frontend.vercel.app,http://localhost:3000"
